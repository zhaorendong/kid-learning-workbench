# ---- 本地部署配置：含真实 IP / 账号 / 口令，绝对不能进仓库 ----
_build/site.local.json

# ---- 运行日志与临时产物（含本机路径与内网信息）----
_build/*.log
_build/_*.txt
_build/_*.json
*.log

# ---- Python 缓存 ----
__pycache__/
*.py[cod]

# ---- 工作区内部数据（会话记忆、临时目录）----
.workbuddy/

# ---- 访问二维码：任意命名都要排除（都承载家里的真实网络地址）----
qr-*.png
*二维码*.png

# ---- 视频库 ----
# 体积大、常含版权素材，不进仓库；走 _build/deploy_videos.py 单独上传
videos/

# ---- 数独模块的音频残留 ----
# 91 个 mp3 是历史构建产物（音频早已 base64 内嵌进教程 HTML），排除后省 2MB。
# 注意只排除音频本身，_build/ 下的生成脚本与题库数据要保留。
一年级数独/**/*.mp3
一年级数独/_build/audio/
一年级数独/_build/audio_backup_*/
一年级数独/_build/*.log

# ---- 抓取 / 下载产生的临时产物（不属于这个项目，别进公开仓库）----
# 这些是抓第三方课程时留下的脚本、API 响应与截图，留在本机就行
_build/zebra_*
_build/detail_*.json
_build/free_*.json
_build/clewm_*.html
_build/download_*.py
_build/parse_*.py
_build/trace_*.py
_build/shot_*.png

# ---- 魂师对决的人物肖像：版权状态不确定，默认不进公开仓库 ----
# （自己画的 / 确认可商用的素材，想一起开源就删掉下面四行）
modules/math-wuhun-5/portraits/*.jpg
modules/math-wuhun-5/portraits/*.jpeg
modules/math-wuhun-5/portraits/*.png
modules/math-wuhun-5/portraits/*.webp

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
